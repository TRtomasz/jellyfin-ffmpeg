From 3f7cc9a331c651010ea1c9c5ce9137487eb0f137 Mon Sep 17 00:00:00 2001
From: TRtomasz <t.rokita@stremio.com>
Date: Wed, 23 Jul 2025 18:16:38 +0200
Subject: [PATCH] Revert changes

---
 libavformat/movenc.c | 6 +-----
 1 file changed, 1 insertion(+), 5 deletions(-)

diff --git a/libavformat/movenc.c b/libavformat/movenc.c
index d6effda6..7ed27bde 100644
--- a/libavformat/movenc.c
+++ b/libavformat/movenc.c
@@ -5527,8 +5527,7 @@ static int mov_write_sidx_tag(AVIOContext *pb,
 
     if (track->entry) {
         entries = 1;
-        presentation_time = track->cluster[0].dts + track->cluster[0].cts -
-                            track->start_dts - track->start_cts;
+        presentation_time = track->cluster[0].dts + track->cluster[0].cts;
         duration = track->end_pts -
                    (track->cluster[0].dts + track->cluster[0].cts);
         starts_with_SAP = track->cluster[0].flags & MOV_SYNC_SAMPLE;
@@ -5543,9 +5542,6 @@ static int mov_write_sidx_tag(AVIOContext *pb,
         if (entries <= 0)
             return 0;
         presentation_time = track->frag_info[0].time;
-        /* presentation_time <= 0 is handled by mov_add_tfra_entries() */
-        if (presentation_time > 0)
-            presentation_time -= track->start_dts + track->start_cts;
     }
 
     avio_wb32(pb, 0); /* size */
-- 
